Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded: [ /Global Options1, /PointCloud2Livox1, /PointCloud2Map1, /TF1 ]
      Splitter Ratio: 0.5
    Tree Height: 480
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.6
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          slam_map:
            odom:
              base_link:
                imu_link: {}
                livox_frame: {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Livox Mid-360 scan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /livox/lidar
      Size (Pixels): 2
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 220; 80
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: GLIM map
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /glim_ros/map
      Size (Pixels): 2
      Style: Flat Squares
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: GLIM odometry
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /glim_ros/odom
      Shape: Arrow
      Keep: 50
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 40; 45
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 24
      Focal Point: 5; 10; 0
      Pitch: 1.0
      Yaw: 0.7
      Name: Orbit
      Target Frame: map
Window Geometry:
  Height: 900
  Width: 1400
  X: 80
  Y: 40
