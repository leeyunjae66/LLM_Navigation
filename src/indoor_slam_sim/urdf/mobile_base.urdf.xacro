<?xml version="1.0"?>
<robot name="indoor_mobile_base" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link">
    <inertial>
      <mass value="12.0"/><origin xyz="0 0 0"/>
      <inertia ixx="0.185" ixy="0" ixz="0" iyy="0.185" iyz="0" izz="0.290"/>
    </inertial>
    <visual><origin xyz="0 0 0"/><geometry><cylinder radius="0.22" length="0.22"/></geometry>
      <material name="body_blue"><color rgba="0.12 0.28 0.48 1"/></material></visual>
    <collision><geometry><cylinder radius="0.22" length="0.22"/></geometry></collision>
  </link>

  <link name="left_wheel_link">
    <inertial><mass value="0.6"/><inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0015"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.04"/></geometry>
      <material name="rubber"><color rgba="0.06 0.06 0.06 1"/></material></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.04"/></geometry></collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel_link"/><origin xyz="0 0.14 -0.07"/><axis xyz="0 1 0"/>
    <limit effort="8" velocity="4"/><dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="right_wheel_link">
    <inertial><mass value="0.6"/><inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0015"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.04"/></geometry>
      <material name="rubber"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.10" length="0.04"/></geometry></collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel_link"/><origin xyz="0 -0.14 -0.07"/><axis xyz="0 1 0"/>
    <limit effort="8" velocity="4"/><dynamics damping="0.05" friction="0.02"/>
  </joint>

  <xacro:macro name="caster" params="side x">
    <link name="${side}_caster_link">
      <inertial><mass value="0.15"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
      <visual><geometry><sphere radius="0.04"/></geometry><material name="caster"><color rgba="0.25 0.25 0.25 1"/></material></visual>
      <collision><geometry><sphere radius="0.04"/></geometry></collision>
    </link>
    <joint name="${side}_caster_fixed_joint" type="fixed">
      <parent link="base_link"/><child link="${side}_caster_link"/><origin xyz="${x} 0 -0.13"/>
    </joint>
    <gazebo reference="${side}_caster_link"><mu1>0.05</mu1><mu2>0.05</mu2><kp>100000</kp><kd>1</kd></gazebo>
  </xacro:macro>
  <xacro:caster side="front" x="0.16"/>
  <xacro:caster side="rear" x="-0.16"/>

  <link name="imu_link">
    <inertial><mass value="0.02"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
    <visual><geometry><box size="0.04 0.04 0.02"/></geometry><material name="imu_case"><color rgba="0.2 0.8 0.2 1"/></material></visual>
  </link>
  <joint name="imu_mount_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.07"/></joint>

  <link name="livox_frame">
    <inertial><mass value="0.18"/><inertia ixx="0.00018" ixy="0" ixz="0" iyy="0.00018" iyz="0" izz="0.00018"/></inertial>
    <visual><geometry><cylinder radius="0.045" length="0.07"/></geometry><material name="lidar_case"><color rgba="0.18 0.18 0.20 1"/></material></visual>
    <collision><geometry><cylinder radius="0.045" length="0.07"/></geometry></collision>
  </link>
  <joint name="livox_mount_joint" type="fixed"><parent link="base_link"/><child link="livox_frame"/><origin xyz="0 0 0.19"/></joint>

  <gazebo reference="left_wheel_link"><mu1>1.2</mu1><mu2>1.2</mu2><kp>1000000</kp><kd>10</kd></gazebo>
  <gazebo reference="right_wheel_link"><mu1>1.2</mu1><mu2>1.2</mu2><kp>1000000</kp><kd>10</kd></gazebo>

  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0.07 0 0 0</pose>
      <always_on>true</always_on><update_rate>200</update_rate><visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="livox_frame">
    <sensor name="mid360" type="gpu_ray">
      <pose>0 0 0 0 0 0</pose><always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>2048</samples><resolution>1</resolution><min_angle>-3.1415926535</min_angle><max_angle>3.1415926535</max_angle></horizontal>
          <vertical><samples>128</samples><resolution>1</resolution><min_angle>-0.126</min_angle><max_angle>0.965</max_angle></vertical></scan>
        <range><min>0.15</min><max>30.0</max><resolution>0.01</resolution></range>
      </ray>
      <plugin name="mid360_pattern" filename="libindoor_mid360_gpu_plugin.so">
        <ros><namespace>/</namespace></ros>
        <topic>/livox/lidar</topic><frame_id>livox_frame</frame_id>
        <csv_file_name>$(find indoor_slam_sim)/models/mid360.csv</csv_file_name>
        <samples>2000</samples><min_range>0.15</min_range><max_range>30.0</max_range>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="indoor_sim_imu" filename="libindoor_imu_plugin.so">
      <ros><namespace>/</namespace></ros>
      <link_name>base_link</link_name><frame_name>imu_link</frame_name><update_rate>200</update_rate>
    </plugin>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace><remapping>cmd_vel:=/cmd_vel_limited</remapping><remapping>odom:=/wheel/odom</remapping></ros>
      <update_rate>100</update_rate><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.28</wheel_separation><wheel_diameter>0.20</wheel_diameter>
      <max_wheel_torque>8.0</max_wheel_torque><max_wheel_acceleration>4.0</max_wheel_acceleration>
      <command_topic>/cmd_vel_limited</command_topic><odometry_topic>/wheel/odom</odometry_topic>
      <odometry_frame>odom_wheel</odometry_frame><robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom><publish_odom_tf>false</publish_odom_tf><publish_wheel_tf>false</publish_wheel_tf>
      <odometry_source>0</odometry_source>
    </plugin>
  </gazebo>
</robot>
